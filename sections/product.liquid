{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="container pt-7 lg:pt-14 flex flex-col lg:flex-row gap-[30px]">
  <div class="product__gallery hidden lg:block">
    <ul class="flex gap-[22px] flex-wrap">
      {% for image in product.images %}
        <li class="w-[calc(50%_-_11px)] border border-fulton-light-green rounded-[20px] overflow-hidden">
          {{
            image
            | image_url: width: 800
            | image_tag: alt: image.alt, class: 'w-full aspect-[1.3] object-cover', loading: 'lazy'
          }}
        </li>
      {% endfor %}
    </ul>
  </div>
  <div class="product__details w-full lg:max-w-[420px] shrink-0">
    <h1 class="text-fulton-green text-3xl font-semibold mb-2">{{ product.title }}</h1>
    <div class="rating flex gap-3 items-center mb-4">
      <ul class="stars flex gap-1">
        {% for i in (1..product.metafields.custom.rating) %}
          <li class="w-4">
            <svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.88 117.1">
              <defs><style>.cls-1{fill:#FFBF3F;}</style></defs><title>star-symbol</title><path class="cls-1" d="M64.42,2,80.13,38.7,120,42.26a3.2,3.2,0,0,1,1.82,5.62h0L91.64,74.18l8.9,39A3.19,3.19,0,0,1,98.12,117a3.27,3.27,0,0,1-2.46-.46L61.41,96.1,27.07,116.64a3.18,3.18,0,0,1-4.38-1.09,3.14,3.14,0,0,1-.37-2.38h0l8.91-39L1.09,47.88a3.24,3.24,0,0,1-.32-4.52,3.32,3.32,0,0,1,2.29-1l39.72-3.56L58.49,2a3.24,3.24,0,0,1,5.93,0Z"/>
            </svg>
          </li>
        {% endfor %}
      </ul>
      <a href="#" class="leading-none text-black font-semibold underline">
        {{- product.metafields.custom.reviews }}
        {% if product.metafields.custom.reviews == 1 %}Review{% else %}Reviews{% endif -%}
      </a>
    </div>
    <div class="price flex gap-4 items-center mb-6">
      <div class="current text-fulton-green text-4xl font-semibold">
        {{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}
      </div>
      <div class="compare text-fulton-light-green text-4xl font-semibold line-through">
        {{ product.selected_or_first_available_variant.compare_at_price | money_without_trailing_zeros }}
      </div>
      {% if product.selected_or_first_available_variant.compare_at_price
          != product.selected_or_first_available_variant.price
      %}
        <div class="discount bg-fulton-light-green text-lg text-fulton-green p-[9px] leading-none">
          <span>
            {{-
              product.compare_at_price_max
              | minus: product.selected_or_first_available_variant.price
              | times: 100.0
              | divided_by: product.compare_at_price_max
              | money_without_currency
              | times: 100
              | remove: '.0'
            -}}</span
          >% OFF
        </div>
      {% endif %}
    </div>
    <div class="swiper mySwiper lg:!hidden !-mr-5 !-ml-5 !px-5">
      <div class="swiper-wrapper">
        {% for image in product.images %}
          <div class="swiper-slide border border-fulton-light-green rounded-[20px] overflow-hidden">
            {{
              image
              | image_url: width: 800
              | image_tag: alt: image.alt, class: 'w-full aspect-[1.3] object-cover', loading: 'lazy'
            }}
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination !relative !mt-[18px] !text-left"></div>
    </div>
    <div class="description text-lg text-fulton-green pr-5">
      {{ product.description }}
    </div>
    <div class="options">
      {% for option in product.options_with_values %}
        {% if option.name != 'Size' %}
          <div class="option-group mb-2" id="{{ option.name | downcase}}">
            <fieldset class="flex gap-3">
              <legend class="text-fulton-green text-sm mb-1 block">{{ option.name }}:</legend>
              {% for value in option.values %}
                <input
                  class="hidden"
                  type="radio"
                  name="{{ option.name | downcase}}"
                  id="{{ value | downcase }}"
                  {% if forloop.index == 1 %}
                    checked
                  {% endif %}
                >
                <label
                  for="{{ value | downcase }}"
                  class="w-full text-lg leading-none text-center rounded-[10px] bg-white text-fulton-green border border-fulton-green p-2 cursor-pointer"
                >
                  {{- value -}}
                </label>
              {% endfor %}
            </fieldset>
          </div>
        {% else %}
          <div class="option-group mb-2 relative" id="{{ option.name | downcase}}">
            <fieldset class="flex gap-1">
              <legend class="text-fulton-green text-sm mb-1 block">{{ option.name }}:</legend>
              {% if section.settings.help_link -%}
                <a
                  href="{{ section.settings.help_link }}"
                  title="{{ section.settings.help_text }}"
                  class="absolute top-0 right-0 text-fulton-green text-sm underline"
                >
                  {{- section.settings.help_text -}}
                </a>
              {%- endif %}
              {% for variant in product.variants %}
                <input
                  class="hidden"
                  data-option="{{ variant.option1 | downcase }}_{{ variant.option2 | downcase }}"
                  data-size="{{ variant.option3 | downcase }}"
                  type="radio"
                  name="{{ option.name | downcase}}"
                  id="{{ variant.id }}"
                  {% if forloop.index == 1 %}
                    checked
                  {% endif %}
                >
                <label
                  for="{{ variant.id }}"
                  class="w-full text-lg leading-none text-center rounded-[10px] bg-white text-fulton-green border border-fulton-green p-2 cursor-pointer"
                >
                  {{- variant.option3 | downcase -}}
                </label>
              {% endfor %}
            </fieldset>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="product-form">
      {% form 'product', product %}
        {% assign current_variant = product.selected_or_first_available_variant %}

        <select name="id" class="hidden">
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              data-price="{{ variant.price | money_without_currency | divided_by:1 | remove: '.0' }}"
              data-compare="{{ variant.compare_at_price | money_without_currency | divided_by:1 | remove: '.0' }}"
              {% if variant == current_variant %}
                selected="selected"
              {% endif %}
            >
              {{ variant.title }}
            </option>
          {% endfor %}
        </select>

        <input type="text" name="quantity" min="1" value="1" class="hidden">

        <button
          class="bg-fulton-green text-white text-xl flex gap-4 items-center justify-center w-full p-3 mt-4 transition-all hover:text-fulton-yellow"
          type="submit"
        >
          Add to Cart
          <span id="button-price">
            {{- product.selected_or_first_available_variant.price | money_without_trailing_zeros -}}
          </span>
        </button>
      {% endform %}
    </div>
    {% if section.settings.guarantee_text != blank %}
      <div class="guarantee mt-4 flex gap-4 items-center justify-center text-base lg:text-[22px] text-fulton-green">
        {{ section.settings.guarantee_icon | image_url: width: 30 | image_tag: alt: 'Site Logo', loading: 'lazy' }}
        {{ section.settings.guarantee_text }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "image_picker",
      "id": "guarantee_icon",
      "label": "Guarantee Icon"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help Text",
      "default": "Help Me Choose"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help Link"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
